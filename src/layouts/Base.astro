---
// Estructura común a todas las páginas: encabezado, menú, pie y botón de WhatsApp.
// El contenido (nombre, menú, colores, contacto) se edita en src/data/sitio.json
import sitio from '../data/sitio.json';
import '../styles/global.css';

const { titulo, descripcion } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · ${sitio.profesion}`;
const linkWhatsapp = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(sitio.mensajeWhatsapp)}`;
const rutaActual = Astro.url.pathname.replace(/\/$/, '') || '/';
const c = sitio.colores;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion ?? sitio.descripcion} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion ?? sitio.descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
    <style set:html={`:root{--fondo:${c.fondo};--texto:${c.texto};--principal:${c.principal};--suave:${c.suave};}`}></style>
  </head>
  <body>
    <header class="encabezado">
      <div class="contenedor">
        <a class="marca" href="/">
          <strong>{sitio.nombre}</strong>
          <span>{sitio.profesion}</span>
        </a>
        <nav class="menu" aria-label="Menú principal">
          {sitio.menu.map((item) => (
            <a href={item.link} aria-current={rutaActual === item.link ? 'page' : undefined}>{item.texto}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor">
        <span>© {new Date().getFullYear()} {sitio.nombre} · {sitio.ubicacion}</span>
        <span>
          <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
          {(sitio.redes ?? []).map((r) => <> · <a href={r.link} target="_blank" rel="noopener">{r.texto}</a></>)}
        </span>
      </div>
    </footer>

    {sitio.whatsapp && <a class="whatsapp" href={linkWhatsapp} target="_blank" rel="noopener" aria-label="Escribime por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.4-.3Z"/></svg>
    </a>}
  </body>
</html>
